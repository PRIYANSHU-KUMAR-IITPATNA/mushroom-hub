  --text-sm: 0.875rem;
  --text-base: 1rem;
  --text-lg: 1.125rem;
  --font-weight-medium: 550;
  --font-weight-semibold: 650;
  --font-weight-bold: 700;
  --line-height-body: 1.7;
  --line-height-heading: 1.2;

  --space-1: 0.375rem;
  --space-2: 0.75rem;
  --space-3: 1rem;
  --space-4: 1.5rem;
  --space-5: 2rem;
  --space-6: 3rem;
  --space-7: 4.5rem;
  --space-8: 6rem;

  --radius-small: 0.375rem;
  --radius-medium: 0.75rem;
  --radius-large: 1rem;
  --border-subtle: 1px solid var(--color-border);
  --shadow-card: 0 12px 32px rgb(37 55 39 / 6%);
  --content-width: 72rem;
  --transition-fast: 150ms ease;

  font-size: 16px;
}

* {
  box-sizing: border-box;
}

html {
  min-width: 0;
  scroll-behavior: smooth;
  scroll-padding-top: 6rem;
}

body {
  min-width: 0;
  min-height: 100vh;
  margin: 0;
  font-family: var(--font-body);
  color: var(--color-ink);
  background: var(--color-paper);
  line-height: var(--line-height-body);
}

body,
button,
a {
  font-family: var(--font-body);
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
}

button {
  color: inherit;
}

::selection {
  color: var(--color-white);
  background: var(--color-forest);
}

:focus-visible {
  outline: 3px solid #b66f3d;
  outline-offset: 3px;
}

.app-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  width: min(100% - 2.5rem, var(--content-width));
  margin-inline: auto;
}

.skip-link {
  position: fixed;
  z-index: 5;
  top: var(--space-3);
  left: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-small);
  color: var(--color-white);
  background: var(--color-forest-deep);
  transform: translateY(-180%);
}

.skip-link:focus {
  transform: translateY(0);
}

.site-header {
  position: relative;
  z-index: 1;
  border-bottom: var(--border-subtle);
  background: rgb(252 251 247 / 94%);
}

.site-header__inner {
  min-height: 5.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  text-decoration: none;
}

.brand__mark {
  width: 2.5rem;
  height: 2.5rem;
  display: grid;
  place-items: center;
  border-radius: var(--radius-small);
  color: var(--color-white);
  background: var(--color-forest);
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 700;
}

.brand__text {
  display: grid;
  gap: 0.125rem;
}

.brand__name {
  color: var(--color-forest-deep);
  font-size: 1rem;
  font-weight: var(--font-weight-bold);
  letter-spacing: -0.025em;
}

.brand__descriptor {
  color: var(--color-muted);
  font-size: 0.6875rem;
  letter-spacing: 0.015em;
}

.site-nav {
  display: flex;
  align-items: center;
  gap: clamp(var(--space-3), 3vw, var(--space-5));
}

.site-nav__link,
.site-footer__link {
  color: var(--color-muted);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.site-nav__link:hover,
.site-footer__link:hover {
  color: var(--color-forest);
}

.language-switcher {
  display: inline-flex;
  flex: none;
  align-items: center;
  gap: 0.125rem;
  padding: 0.1875rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-medium);
  background: var(--color-white);
}

.button {
  min-height: 2.75rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  padding: 0.65rem 1.1rem;
  border: 1px solid transparent;
  border-radius: var(--radius-small);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  line-height: 1.2;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  transition:
    background-color var(--transition-fast),
    border-color var(--transition-fast),
    color var(--transition-fast),
    box-shadow var(--transition-fast);
}

.button--primary {
  color: var(--color-white);
  background: var(--color-forest);
}

.button--primary:hover {
  background: var(--color-forest-deep);
  box-shadow: 0 3px 10px rgb(25 58 44 / 18%);
}

.button--secondary {
  border-color: #cbd7cb;
  color: var(--color-forest-deep);
  background: var(--color-white);
}

.button--secondary:hover {
  border-color: var(--color-green);
  background: var(--color-green-soft);
}

.button--text {
  color: var(--color-forest);
  background: transparent;
}

.button--text:hover {
  background: var(--color-green-soft);
}

.language-switcher__option {
  min-height: 2rem;
  padding: 0.35rem 0.55rem;
  font-size: var(--text-xs);
  font-weight: 600;
}

.language-switcher__option.button--primary {
  border-color: var(--color-forest);
}

.eyebrow {
  margin: 0 0 var(--space-2);
  color: var(--color-green);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-bold);
  letter-spacing: 0.12em;
  line-height: 1.5;
  text-transform: uppercase;
}

.site-header__tools {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.site-header__action {
  min-height: 2.5rem;
  padding-inline: 1rem;
}

.hero-section {
  overflow: clip;
  background:
    radial-gradient(ellipse at 77% 48%, rgb(221 232 210 / 58%), transparent 35%),
    var(--color-warm);
}

.hero-section__inner {
  min-height: 36rem;
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
  align-items: center;
  gap: var(--space-5);
  padding-block: var(--space-7);
}

.hero-copy {
  position: relative;
  z-index: 1;
  max-width: 42rem;
}

.hero-title {
  margin: 0;
  color: var(--color-forest-deep);
  font-family: var(--font-display);
  font-size: clamp(3rem, 6vw, 5rem);
  font-weight: 600;
  letter-spacing: -0.045em;
  line-height: 1.03;
}

.hero-description {
  max-width: 37rem;
  margin: var(--space-4) 0 0;
  color: var(--color-ink);
  font-size: clamp(var(--text-base), 2vw, 1.1875rem);
  line-height: 1.75;
}

.hero-location {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin: var(--space-4) 0 0;
  color: var(--color-muted);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
}

.hero-location__dot {
  width: 0.55rem;
  height: 0.55rem;
  flex: none;
  border-radius: 50%;
  background: var(--color-green);
  box-shadow: 0 0 0 0.25rem var(--color-green-soft);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-5);
}

.hero-actions .button {
  min-height: 3rem;
  padding-inline: 1.35rem;
}

.hero-visual {
  min-height: 26rem;
  position: relative;
  display: grid;
  place-items: center;
}

.hero-visual::before {
  width: min(100%, 25rem);
  aspect-ratio: 1;
  position: absolute;
  border: 1px solid rgb(71 122 80 / 15%);
  border-radius: 50%;
  background: rgb(255 255 255 / 38%);
  content: "";
}

.mushroom-illustration {
  width: 20rem;
  height: 20rem;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 1rem 1rem rgb(52 68 43 / 9%));
}

.mushroom-illustration__cap {
  width: 17rem;
  height: 8.8rem;
  position: absolute;
  z-index: 2;
  top: 3rem;
  left: 1.5rem;
  border: 1px solid rgb(112 91 65 / 16%);
  border-radius: 10rem 10rem 3.5rem 3.5rem;
  background:
    radial-gradient(ellipse at 38% 27%, #ad744e 0 2.2%, transparent 2.8%),
    radial-gradient(ellipse at 68% 32%, #ad744e 0 2%, transparent 2.7%),
    radial-gradient(ellipse at 53% 17%, #ad744e 0 1.8%, transparent 2.5%),
    linear-gradient(145deg, #d7a477, #bd8057 68%, #a96847);
  box-shadow: inset 0 -0.75rem rgb(123 73 48 / 13%);
  transform: rotate(-5deg);
}

.mushroom-illustration__gills {
  width: 13rem;
  height: 1.6rem;
  position: absolute;
  z-index: 3;
  top: 10.5rem;
  left: 3.1rem;
  border-radius: 50%;
  background: repeating-linear-gradient(
    90deg,
    #d8cbb0 0 1px,
    transparent 1px 0.65rem
  );
  opacity: 0.8;
}

.mushroom-illustration__stem {
  width: 6rem;
  height: 7.2rem;
  position: absolute;
  top: 10.9rem;
  left: 7rem;
  border-radius: 1rem 1rem 2.5rem 2.5rem;
  background: linear-gradient(90deg, #e4dac3, #faf5e8 52%, #d1c6ad);
  box-shadow: inset -0.5rem 0 #c9bfa8;
}

.mushroom-illustration__leaf {
  width: 5.5rem;
  height: 2.4rem;
  position: absolute;
  z-index: 4;
  right: 0.2rem;
  bottom: 1.15rem;
  border-radius: 100% 0 100% 0;
  background: #66885b;
  transform: rotate(-23deg);
}

.mushroom-illustration__ground {
  width: 18rem;
  height: 2.7rem;
  position: absolute;
  bottom: 0;
  left: 1rem;
  border-radius: 50%;
  background: #82966e;
  box-shadow: inset 0 0.5rem rgb(255 255 255 / 15%);
}

.hero-visual__caption {
  position: absolute;
  right: 0;
  bottom: 0;
  color: var(--color-muted);
  font-size: 0.625rem;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.page-section {
  padding-block: var(--space-8);
}

.section-heading {
  max-width: 43rem;
  margin-bottom: var(--space-5);
}

.section-heading__title {
  margin: 0;
  color: var(--color-forest-deep);
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 2.75rem);
  font-weight: 600;
  letter-spacing: -0.035em;
  line-height: var(--line-height-heading);
}

.section-heading__description {
  margin: var(--space-3) 0 0;
  color: var(--color-muted);
  font-size: var(--text-base);
  line-height: var(--line-height-body);
}

.how-section {
  background: var(--color-paper);
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--space-3);
  margin: 0;
  padding: 0;
  list-style: none;
}

.process-card {
  min-height: 15.5rem;
  height: 100%;
  padding: var(--space-4);
}

.card {
  border: var(--border-subtle);
  border-radius: var(--radius-large);
  background: var(--color-white);
  box-shadow: var(--shadow-card);
}

.process-card__number {
  width: 2.5rem;
  height: 2.5rem;
  display: grid;
  place-items: center;
  margin-bottom: var(--space-4);
  border-radius: var(--radius-small);
  color: var(--color-forest);
  background: var(--color-green-soft);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-bold);
}

.process-card__title {
  margin: 0;
  color: var(--color-forest-deep);
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 600;
  line-height: 1.3;
}

.process-card__description {
  margin: var(--space-2) 0 0;
  color: var(--color-muted);
  font-size: var(--text-sm);
  line-height: var(--line-height-body);
}

.model-note {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  margin: var(--space-4) 0 0;
  padding: var(--space-3) var(--space-4);
  border-left: 3px solid var(--color-green);
  color: var(--color-forest-deep);
  background: var(--color-green-soft);
  font-size: var(--text-sm);
  line-height: 1.6;
}

.model-note__marker {
  width: 1.25rem;
  height: 1.25rem;
  flex: none;
  display: grid;
  place-items: center;
  border: 1px solid currentColor;
  border-radius: 50%;
  font-size: 0.75rem;
  font-weight: 700;
}

.audience-section {
  padding-block: var(--space-8);
}

.farmer-section {
  background: #edf2e9;
}

.buyer-section {
  background: var(--color-white);
}

.audience-section__inner {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 1.1fr);
  align-items: center;
  gap: clamp(var(--space-5), 7vw, var(--space-8));
}

.audience-copy .section-heading {
  margin-bottom: var(--space-4);
}

.benefits-card,
.buyer-card {
  padding: clamp(var(--space-4), 4vw, var(--space-6));
}

.benefits-list {
  display: grid;
  gap: var(--space-3);
  margin: 0;
  padding: 0;
  list-style: none;
}

.benefits-list__item {
  display: grid;
  grid-template-columns: 1.5rem minmax(0, 1fr);
  align-items: start;
  gap: var(--space-2);
  color: var(--color-ink);
  font-size: var(--text-sm);
  line-height: 1.55;
}

.benefits-list__mark {
  width: 1.35rem;
  height: 1.35rem;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: var(--color-forest);
  background: var(--color-green-soft);
  font-size: 1rem;
  font-weight: 700;
}

.entry-note {
  margin-top: var(--space-4);
  padding: var(--space-3);
  border: 1px solid #e7dcc6;
  border-radius: var(--radius-small);
  color: #514633;
  background: #faf6eb;
  scroll-margin-top: 2rem;
}

.entry-note__title {
  margin: 0 0 var(--space-1);
  color: var(--color-forest-deep);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-bold);
}

.entry-note p {
  margin: 0;
  font-size: var(--text-xs);
  line-height: 1.65;
}

.buyer-card__eyebrow {
  margin: 0 0 var(--space-4);
  color: var(--color-green);
  font-size: var(--text-xs);
  font-weight: var(--font-weight-bold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.about-section {
  background: var(--color-warm);
}

.about-section__inner {
  display: grid;
  grid-template-columns: minmax(10rem, 0.65fr) minmax(0, 1.35fr);
  align-items: center;
  gap: var(--space-7);
}

.about-section__stamp {
  width: min(100%, 15rem);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: var(--space-2);
  justify-self: center;
  border: 1px solid #cdd8c8;
  border-radius: 50%;
  color: var(--color-forest);
  background:
    radial-gradient(circle, transparent 58%, rgb(255 255 255 / 58%) 59%),
    #e8eee3;
}

.about-section__stamp span:first-child {
  font-family: var(--font-display);
  font-size: 3rem;
  font-weight: 700;
  letter-spacing: -0.05em;
}

.about-section__stamp span:last-child {
  font-size: var(--text-xs);
  font-weight: var(--font-weight-bold);
  letter-spacing: 0.14em;
}

.about-section__copy .section-heading {
  margin-bottom: var(--space-3);
}

.about-location {
  margin: 0;
  color: var(--color-forest);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-semibold);
  line-height: var(--line-height-body);
}

.final-cta {
  padding-block: var(--space-7);
  color: var(--color-white);
  background: var(--color-forest-deep);
}

.final-cta__inner {
  max-width: 58rem;
  text-align: center;
}

.eyebrow--light {
  color: #c6d8bc;
}

.final-cta__title {
  max-width: 43rem;
  margin: 0 auto;
  color: var(--color-white);
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 600;
  letter-spacing: -0.035em;
  line-height: 1.15;
}

.final-cta__description {
  max-width: 39rem;
  margin: var(--space-3) auto 0;
  color: #e1e9df;
  line-height: var(--line-height-body);
}

.final-cta__actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-4);
}

.final-cta .button--secondary {
  border-color: var(--color-white);
}

.final-cta .button--text {
  color: var(--color-white);
}

.final-cta .button--text:hover {
  background: rgb(255 255 255 / 12%);
}

.site-footer {
  border-top: var(--border-subtle);
  background: var(--color-paper);
}

.site-footer__inner {
  min-height: 7rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding-block: var(--space-4);
}

.site-footer__brand {
  flex: none;
}

.site-footer__nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-2) var(--space-4);
}

.site-footer__link {
  font-size: var(--text-xs);
}

.site-footer__top {
  flex: none;
}

@media (max-width: 900px) {
  .site-header__inner {
    gap: var(--space-3);
  }

  .site-nav {
    gap: var(--space-3);
  }

  .hero-section__inner {
    min-height: 32rem;
    grid-template-columns: minmax(0, 1.1fr) minmax(15rem, 0.9fr);
    gap: var(--space-3);
  }

  .hero-visual {
    transform: scale(0.88);
  }

  .process-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .process-card {
    min-height: 13.5rem;
  }

  .audience-section__inner {
    grid-template-columns: minmax(0, 0.85fr) minmax(18rem, 1.15fr);
    gap: var(--space-5);
  }
}

@media (max-width: 760px) {
  .site-header__inner {
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem 1rem;
    padding-block: var(--space-3);
  }

  .brand {
    grid-column: 1;
    grid-row: 1;
  }

  .site-header__tools {
    grid-column: 2;
    grid-row: 1;
    align-items: flex-end;
    flex-direction: column;
    gap: 0.4rem;
  }

  .site-header__action {
    min-height: 2.1rem;
    padding: 0.45rem 0.75rem;
    font-size: var(--text-xs);
  }

  .site-nav {
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-1);
    padding-top: 0.65rem;
    border-top: var(--border-subtle);
  }

  .site-nav__link {
    padding: 0.35rem 0.1rem;
    font-size: var(--text-xs);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .hero-section__inner {
    min-height: 0;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-6) var(--space-5);
  }

  .hero-copy {
    max-width: 42rem;
  }

  .hero-title {
    max-width: 12ch;
    font-size: clamp(2.8rem, 10vw, 4rem);
  }

  .hero-visual {
    min-height: 18rem;
    transform: none;
  }

  .hero-visual::before {
    width: min(78vw, 19rem);
  }

  .mushroom-illustration {
    transform: scale(0.78);
  }

  .hero-visual__caption {
    right: var(--space-2);
  }

  .page-section,
  .audience-section {
    padding-block: var(--space-6);
  }

  .audience-section__inner,
  .about-section__inner {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  .audience-section__inner--buyer .buyer-card {
    grid-row: 2;
  }

  .about-section__stamp {
    width: 9rem;
  }
}

@media (max-width: 420px) {
  .container {
    width: min(100% - 2rem, var(--content-width));
  }

  .brand__descriptor {
    font-size: 0.625rem;
  }

  .language-switcher__option {
    padding-inline: 0.45rem;
  }

  .hero-title {
    font-size: clamp(2.55rem, 12vw, 3.25rem);
  }

  .hero-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .hero-actions .button {
    width: 100%;
  }

  .hero-visual {
    min-height: 15rem;
    margin-top: -0.5rem;
  }

  .mushroom-illustration {
    transform: scale(0.68);
  }

  .process-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .process-card {
    min-height: 0;
  }

  .site-footer__inner {
    align-items: flex-start;
    flex-direction: column;
  }

  .site-footer__nav {
    justify-content: flex-start;
    gap: var(--space-2) var(--space-3);
  }
}

